prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Hard reset is blocked. Preserve existing project work.",
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "forbidden",
    justification = "Git clean is blocked. Preserve untracked project work.",
)

prefix_rule(
    pattern = ["gh", "auth", "token"],
    decision = "forbidden",
    justification = "Reading GitHub authentication tokens is prohibited.",
)

prefix_rule(
    pattern = ["gh", "secret"],
    decision = "forbidden",
    justification = "Direct GitHub secret manipulation is prohibited.",
)